# All paths may be absolute Windows, WSL, Linux, or macOS paths.
DUBBER_RUNTIME_ROOT=.runtime
DUBBER_OUTPUT_ROOT=outputs
MODEL_SOURCE=modelscope

# Optional overrides. Defaults are derived from DUBBER_RUNTIME_ROOT.
# INDEXTTS_DIR=.runtime/index-tts
# INDEXTTS_MODEL_DIR=.runtime/index-tts/checkpoints
# INDEXTTS_CONFIG=.runtime/index-tts/checkpoints/config.yaml
# ASR_RUNTIME_ROOT=.runtime/asr-runtimes
# TRANSLATION_RUNTIME_ROOT=.runtime/translation-runtimes
# HF_HOME=.runtime/cache/huggingface
# HYMT_HF_HOME=.runtime/cache/huggingface

HF_HUB_DISABLE_XET=1
GRADIO_ANALYTICS_ENABLED=False

# Set before exposing --share or binding to an untrusted network.
# GRADIO_AUTH=username:strong-password

